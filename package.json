{
  "name": "suite-metrics",
  "version": "2.4.0",
  "description": "Easily keep track of metrics for many nested test suites",
  "author": "Reid Moffat <reid.moffat9@gmail.com>",
  "license": "MIT",
  "keywords": [
    "test",
    "metrics",
    "suite",
    "benchmark",
    "performance",
    "time",
    "microseconds",
    "microtime",
    "mocha",
    "mocha-metrics",
    "jest",
    "recursive",
    "nested",
    "performance-tracking",
    "benchmarking",
    "execution-time",
    "performance-metrics"
  ],
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "tsc",
    "build": "tsup src/index.ts --format cjs,esm --dts --minify --clean",
    "test": "pnpm run build && pnpm run loadTS && mocha",
    "test:large": "cross-env RUN_LARGE=true pnpm test",
    "deployHelp": "echo 1) Run 'changeset' 2) Merge changes to main 3) Merge changeset PR 4) pnpm run deploy (verify files look good)",
    "deploy": "git checkout main && git pull && pnpm run build && pnpm publish",
    "loadTS": "cross-env TS_NODE_PROJECT='./tsconfig.json'"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "package.json"
  ],
  "dependencies": {
    "async-mutex": "^0.5.0",
    "immer": "^10.1.3",
    "microtime": "^3.1.1"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.7",
    "@types/chai": "^4.3.17",
    "@types/microtime": "^2.1.2",
    "@types/mocha": "^10.0.7",
    "@types/node": "^22.1.0",
    "@types/serialize-javascript": "^5.0.4",
    "bias-random": "^1.0.2",
    "chai": "^5.1.1",
    "cross-env": "^7.0.3",
    "generate-arrays": "^2.0.0",
    "mocha": "^10.7.0",
    "serialize-javascript": "^6.0.2",
    "test-inputs": "^1.3.0",
    "ts-node": "^10.9.2",
    "tsup": "^8.2.4",
    "typescript": "^5.5.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/reid-moffat/suite-metrics.git"
  },
  "funding": {
    "type": "buymeacoffee",
    "url": "https://buymeacoffee.com/reidmoffat"
  },
  "bugs": "https://github.com/reid-moffat/suite-metrics/issues",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "microtime"
    ]
  },
  "packageManager": "pnpm@10.18.3"
}
